<?xml version="1.0" encoding="UTF-8"?>
<Context reloadable="true">
  <Resource
    name="jdbc/bookorder"
    auth="Container"
    type="javax.sql.DataSource"
    driverClassName="com.mysql.cj.jdbc.Driver"
    url="jdbc:mysql://127.0.0.1/bookorder"
    username="root"
    password="pass"
    maxTotal="4"
    maxWaitMillis="5000"
    maxIdle="2"
    validationQuery="SELECT COUNT(*) FROM items"
  >
  </Resource>
</Context>
